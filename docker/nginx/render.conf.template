# Booking calendar — single-container nginx vhost (the `render` image stage).
#
# Rendered by docker/php/entrypoint.sh into /etc/nginx/http.d/default.conf at
# container start, because nginx has no equivalent of env() and the platform
# picks the port at runtime (Render injects PORT=10000; Cloud Run and Container
# Apps use 8080). Only the literal ${PORT} token is substituted, so nginx's own
# $uri, $realpath_root and friends are left alone.
#
# This is the deployable twin of docker/nginx/conf.d/app.conf, which is the
# two-container dev/compose vhost. Keep them in step. The differences are only:
#   * `listen ${PORT}` instead of 80
#   * `fastcgi_pass 127.0.0.1:9000` instead of the `php` service name
#   * the HTTPS fastcgi_param, because a PaaS terminates TLS upstream
#   * /healthz is called out, and /fpm-ping is not exposed at all
#
# http.d/*.conf is included inside nginx's `http` block on Alpine, so the
# http-context `map` below is legal here.

# Symfony has to be told the original scheme or it builds http:// URLs behind
# the platform's TLS terminator - the verification email's link, for one. A map
# rather than the raw header: the value must be empty (not "off") for plain
# http, and a request claiming X-Forwarded-Proto: http would otherwise be able
# to downgrade itself. Render always sets this header itself.
map $http_x_forwarded_proto $forwarded_https {
    default '';
    https   'on';
}

server {
    listen ${PORT};
    server_name _;

    root /var/www/html/public;
    index index.php;

    client_max_body_size 16m;

    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_comp_level 5;
    gzip_types
        application/javascript
        application/json
        application/ld+json
        application/manifest+json
        application/rss+xml
        application/xml
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    # The platform's liveness probe. Through php-fpm on purpose (see
    # src/Controller/HealthController.php): nginx answering alone would report
    # a container healthy while PHP was dead.
    location = /healthz {
        access_log off;
        try_files $uri /index.php$is_args$args;
    }

    # AssetMapper emits digest-hashed filenames, so compiled assets are
    # content-addressed and safe to cache forever. They are baked into this
    # image by the `assets` stage, so the try_files fallback only matters if
    # one is ever missing.
    location ^~ /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri /index.php$is_args$args;
    }

    # Never serve dotfiles (.env, .git, editor droppings) even if one lands in public/.
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        # Only reachable through the try_files rewrite above.
        internal;

        fastcgi_pass 127.0.0.1:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT   $realpath_root;
        fastcgi_param PATH_INFO       $fastcgi_path_info;
        fastcgi_param HTTPS           $forwarded_https if_not_empty;

        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 60s;
        fastcgi_hide_header X-Powered-By;
    }

    # Any other .php URI is a mistake or an attack, not a route.
    location ~ \.php$ {
        return 404;
    }
}
