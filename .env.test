# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The test suite builds its schema from the entity mapping into a throwaway
# SQLite file, so `vendor/bin/phpunit` needs neither a PostgreSQL server nor
# Docker. `make test-postgres` points it at the compose `database` service
# instead, to exercise the dialect production runs on:
# DATABASE_URL="postgresql://booking_calendar:booking_calendar@database:5432/booking_calendar?serverVersion=18&charset=utf8"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
