# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# The verification link app:verification-link prints is signed for this origin
# and only works when opened there; set it to the public URL of a deployment.
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# `serverVersion` lets Doctrine choose the SQL dialect without opening a connection.
# Host "database" is the PostgreSQL service in compose.yaml; use 127.0.0.1:15432 from the host.
# A managed Postgres (Neon) needs `&sslmode=require` on the end; see the README's "Deploying it".
DATABASE_URL="postgresql://booking_calendar:booking_calendar@database:5432/booking_calendar?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app ###
# A day accepts as many reservations as it is given: the per-day cap the legacy
# app enforced in the browser (and this app once expressed as a unique
# (reserved_on, slot) index) has been removed, so there is no limit to set.

# Bookings per page: the dashboard's list size, and how many bookings the
# calendar fetches at a time before it draws what it has and asks for more.
BOOKINGS_PER_PAGE=10

# Customers per page of the directory.
CUSTOMERS_PER_PAGE=25

# Who verification emails come from. In production this must be, exactly, a
# sender validated in the Brevo account (see the README's Configuration table).
MAILER_FROM="Booking Calendar <no-reply@booking-calendar.test>"
###< app ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###
